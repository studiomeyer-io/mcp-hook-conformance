{
  "name": "mcp-hook-conformance",
  "version": "0.1.3",
  "description": "Test-harness CLI that audits any MCP server for Claude Code v2.1.118 mcp_tool lifecycle-hook readiness (idempotency, latency, determinism, side-effects, dsgvo).",
  "type": "module",
  "license": "MIT",
  "author": "Matthias Meyer (StudioMeyer)",
  "homepage": "https://github.com/studiomeyer-io/mcp-hook-conformance",
  "repository": {
    "type": "git",
    "url": "https://github.com/studiomeyer-io/mcp-hook-conformance.git"
  },
  "bugs": {
    "url": "https://github.com/studiomeyer-io/mcp-hook-conformance/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "hooks",
    "conformance",
    "audit",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-hook-conformance": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "RUN_SMOKE_TESTS=1 vitest run tests/smoke",
    "lint:types": "tsc --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "mcp": {
    "specVersion": "2025-06-18",
    "claudeCodeMinVersion": "2.1.118"
  },
  "mcpName": "io.studiomeyer/hook-conformance",
  "overrides": {
    "fast-uri": ">=3.1.2"
  }
}
